# ==============================================================================
# TEMPLATE DE CONFIGURAÇÃO DE VARIÁVEIS DE AMBIENTE (.env)
# Copie este arquivo para ".env" e preencha com as credenciais da sua agência.
# NUNCA envie o arquivo ".env" preenchido para o GitHub.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. META ADS (Facebook / Instagram Ads API)
# ------------------------------------------------------------------------------
META_ACCESS_TOKEN=seu_meta_access_token_aqui
META_ACCOUNT_ID=act_sua_conta_aqui
META_BUSINESS_ID=seu_business_id_aqui

# ------------------------------------------------------------------------------
# 2. GOOGLE ADS API
# ------------------------------------------------------------------------------
GOOGLE_ADS_DEVELOPER_TOKEN=seu_developer_token_aqui
GOOGLE_ADS_CLIENT_ID=seu_client_id.apps.googleusercontent.com
GOOGLE_ADS_CLIENT_SECRET=seu_client_secret_aqui
GOOGLE_ADS_REFRESH_TOKEN=seu_refresh_token_aqui
GOOGLE_ADS_CUSTOMER_ID=123-456-7890

# ------------------------------------------------------------------------------
# 3. GA4 & GTM (Google Analytics 4 & Tag Manager)
# ------------------------------------------------------------------------------
GA4_PROPERTY_ID=123456789
SA_CREDS_PATH=service-account.json
GTM_ACCOUNT_ID=12345678
GTM_CONTAINER_ID=98765432

# ------------------------------------------------------------------------------
# 4. GOOGLE MEU NEGÓCIO (Google Business Profile)
# ------------------------------------------------------------------------------
GOOGLE_BUSINESS_SA_PATH=google_business_sa.json

# ------------------------------------------------------------------------------
# 5. LINKEDIN ADS & TIKTOK ADS
# ------------------------------------------------------------------------------
LINKEDIN_ACCESS_TOKEN=seu_linkedin_token_aqui
TIKTOK_ACCESS_TOKEN=seu_tiktok_token_aqui
TIKTOK_BUSINESS_ID=seu_tiktok_business_id_aqui

# ------------------------------------------------------------------------------
# 6. YOUTUBE DATA API & WORDPRESS REST API
# ------------------------------------------------------------------------------
YOUTUBE_API_KEY=sua_youtube_api_key_aqui
WP_URL=https://seu-site.com.br
WP_USER=seu_usuario_admin
WP_APP_PASSWORD=sua_senha_de_aplicacao_wp

# ------------------------------------------------------------------------------
# 7. TYPEBOT (Qualificação de Leads)
# ------------------------------------------------------------------------------
TYPEBOT_API_TOKEN=seu_typebot_api_token_aqui

# ------------------------------------------------------------------------------
# 8. EVOLUTION API (Disparos e Notificações no WhatsApp)
# ------------------------------------------------------------------------------
EVOLUTION_URL=https://sua-instancia-evolution.com
EVOLUTION_INSTANCE=comercial
EVOLUTION_API_KEY=sua_api_key_evolution_aqui

# ------------------------------------------------------------------------------
# 9. ASAAS & AUTENTIQUE
# ------------------------------------------------------------------------------
ASAAS_API_KEY_PROD=$aact_Y3...
ASAAS_API_KEY_SANDBOX=$aact_sandbox_...
ASAAS_SANDBOX=True
ASAAS_WALLET_ID=sua_wallet_id_aqui
AUTENTIQUE_TOKEN=seu_autentique_token_aqui
AUTENTIQUE_SANDBOX=True

# ------------------------------------------------------------------------------
# 10. TRELLO & CONFIGURAÇÕES GERAIS
# ------------------------------------------------------------------------------
TRELLO_API_KEY=sua_trello_api_key_aqui
TRELLO_TOKEN=seu_trello_token_aqui
TRELLO_BOARD_ONBOARDING_ID=seu_board_id_aqui
TRELLO_LIST_NOVOS_CLIENTES_ID=sua_lista_id_aqui

NOME_AGENCIA="Minha Agência de Tráfego"
EMAIL_NOTIFICACAO_AGENCIA="contato@suaagencia.com.br"
GRUPO_WHATSAPP_ALERTAS_INTERNOS="120363000000000000@g.us"
